# Copy this file to .env and replace every value for your local simulation.
BANK_A_ID=BANK_A
BANK_B_ID=BANK_B

MYSQL_A_DATABASE=bank_a
MYSQL_A_USER=bank_a_user
MYSQL_A_PASSWORD=change-me
MYSQL_A_ROOT_PASSWORD=change-root-me

MYSQL_B_DATABASE=bank_b
MYSQL_B_USER=bank_b_user
MYSQL_B_PASSWORD=change-me
MYSQL_B_ROOT_PASSWORD=change-root-me

SIMULATION_SEED_ENABLED=true
BANK_A_ACCOUNT_NUMBER=A-1001
BANK_A_ACCOUNT_HOLDER=Alice
BANK_A_OPENING_BALANCE=2000000.00
BANK_B_ACCOUNT_NUMBER=B-2001
BANK_B_ACCOUNT_HOLDER=Bob
BANK_B_OPENING_BALANCE=500000.00
